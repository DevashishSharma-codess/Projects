└── src/                        # ES6 Modular JavaScript Modules
    ├── script.js               # Application entry point (imports & initializes all modules)
    ├── preloader.js            # Preloader animation & dismiss controller
    ├── navigation.js           # Header scroll listener, hamburger toggle & active scroll spy
